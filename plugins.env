# Default versions and mirrors for plugins.
# Plugin scripts use `${VAR:-default}` so empty/unset values fall back to
# the plugin's own default. Override at runtime by exporting in your shell.

GITHUB_MIRROR=https://github.com

# Ansible
ANSIBLE_VERSION=
ANSIBLE_CORE_VERSION=

# Prometheus stack
PROMETHEUS_VERSION=3.5.1
NODE_EXPORTER_VERSION=1.10.2
PROCESS_EXPORTER_VERSION=0.8.4

VSCODE_COMMIT=0958016b2af9f09bb4257e0df4a95e2f90590f9f